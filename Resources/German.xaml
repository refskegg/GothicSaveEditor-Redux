<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Hauptfenster -->
    <system:String x:Key="GSETitle">GothicSaveEditor Redux</system:String>

    <system:String x:Key="ToolbarOpen">Öffnen</system:String>
    <system:String x:Key="ToolbarSave">Speichern</system:String>
    <system:String x:Key="ToolbarSaveAs">Speichern unter</system:String>
    <system:String x:Key="ToolbarBackup">Backup</system:String>
    <system:String x:Key="ToolbarExport">Export</system:String>
    <system:String x:Key="ToolbarClose">Schließen</system:String>
    <system:String x:Key="ToolbarSettings">Einstellungen</system:String>
    <system:String x:Key="ToolbarAbout">Über</system:String>

    <system:String x:Key="Ready">Bereit — öffne eine SAVEDAT.SAV</system:String>
    <system:String x:Key="UnsavedChangesFormat">{0} ungespeicherte Änderung(en)</system:String>
    <system:String x:Key="VariablesCountFormat">Variablen: {0}</system:String>

    <system:String x:Key="SettingsSectionGame">Spielverzeichnis</system:String>
    <system:String x:Key="SettingsSectionLocalization">Sprache &amp; Zeichensatz</system:String>
    <system:String x:Key="SettingsSectionAppearance">Darstellung &amp; System</system:String>
    <system:String x:Key="SettingsSectionBackups">Automatische Backups</system:String>

    <system:String x:Key="AboutTitle">Über GothicSaveEditor Redux</system:String>
    <system:String x:Key="AboutDescription">Moderner, hochperformanter Savegame-Editor für Gothic 1, Gothic 2 (DNdR) und umfangreiche Mods wie Odyssee (.NET 10).</system:String>
    <system:String x:Key="AboutFeatures">• Strukturierter BinSafe-Parser (thread-sicher, ohne Array- &amp; Overflow-Bugs)&#x0a;• Atomares Speichern mit SHA-256-Integritätsprüfung&#x0a;• Automatische Ordner-Backups mit Rotation in %LOCALAPPDATA%&#x0a;• Flüssige Suche &amp; UI-Virtualisierung auch bei 100.000+ Variablen</system:String>
    <system:String x:Key="AboutCredits">Basiert auf dem ursprünglichen GothicSaveEditor-Fork von Flycrafting (Originalprojekt von RightMAN).</system:String>
    <system:String x:Key="AboutClose">Schließen</system:String>

    <system:String x:Key="Savegame">Spielstand</system:String>
    <system:String x:Key="Open">Öffnen (Strg+A)</system:String>
    <system:String x:Key="Save">Speichern (Strg+S)</system:String>
    <system:String x:Key="SaveAs">Speichern unter (Strg+Umschalt+S)</system:String>
    <system:String x:Key="MakeBackup">Backup erstellen (Strg+B)</system:String>
    <system:String x:Key="Close">Schließen (Strg+X)</system:String>

    <system:String x:Key="Tools">Werkzeuge</system:String>
    <system:String x:Key="ApplyScript">Skript anwenden</system:String>
    <system:String x:Key="ExportVariables">Variablen exportieren</system:String>

    <system:String x:Key="Settings">Einstellungen</system:String>
    <system:String x:Key="About">Über das Programm (GitHub)</system:String>

    <system:String x:Key="Variable">Variable</system:String>
    <system:String x:Key="Value">Wert</system:String>
    <system:String x:Key="Search">Variablen suchen...</system:String>
    <system:String x:Key="Cancel">Abbrechen</system:String>

    <!-- Einstellungsfenster -->
    <system:String x:Key="SettingsWindow">Einstellungen</system:String>
    <system:String x:Key="GothicPath">Pfad zum Gothic-Ordner</system:String>
    <system:String x:Key="Language">Sprache</system:String>
    <system:String x:Key="Encoding">Spielstand-Zeichensatz</system:String>
    <system:String x:Key="Encoding1252">Windows-1252 (Westeuropäisch / Deutsch / Englisch)</system:String>
    <system:String x:Key="Encoding1250">Windows-1250 (Mitteleuropäisch / Polnisch)</system:String>
    <system:String x:Key="Encoding1251">Windows-1251 (Kyrillisch / Russisch)</system:String>
    <system:String x:Key="DarkMode">Dunkles Design (Dark Mode)</system:String>
    <system:String x:Key="AssociateSavFiles">.SAV-Dateien mit GothicSaveEditor verknüpfen</system:String>
    <system:String x:Key="KeepBackups">Backups von Spielständen erstellen und aufbewahren</system:String>
    <system:String x:Key="OpenBackupsFolder">Backup-Ordner öffnen</system:String>
    <system:String x:Key="DeleteBackups">Alle Backups löschen</system:String>

    <system:String x:Key="AgreeBackupsDeleting">Möchtest du wirklich alle Backups unwiderruflich löschen?</system:String>
    <system:String x:Key="CouldNotDeleteBackups">Mindestens ein Backup konnte nicht gelöscht werden. Bitte überprüfe deine Zugriffsrechte.</system:String>

    <!-- Meldungsdialoge -->
    <system:String x:Key="Warning">Warnung</system:String>
    <system:String x:Key="UnexpectedError">Ein unerwarteter Fehler ist aufgetreten:</system:String>

    <system:String x:Key="UnableToSaveSettings">Die aktuellen Einstellungen konnten nicht gespeichert werden! Bitte überprüfe deine Schreibrechte.</system:String>
    <system:String x:Key="UnableToLoadSettings">Einstellungen konnten nicht geladen werden! Standardwerte werden verwendet.</system:String>

    <!-- SaveReader -->
    <system:String x:Key="SRHeaderError">Der Header der Spielstand-Datei konnte nicht gelesen werden!</system:String>
    <system:String x:Key="SRReadBytesError">Die Spielstand-Datei konnte nicht gelesen werden!</system:String>
    <system:String x:Key="SRMaxByteError">Das Ende des Datenbereichs in der Spielstand-Datei konnte nicht gelesen werden!</system:String>
    <system:String x:Key="SREmptyVariablesList">Die Variablenliste ist leer!</system:String>
    <system:String x:Key="SaveIsBrokenText">Der Spielstand ist vermutlich beschädigt!</system:String>

    <system:String x:Key="UnableToSaveSavegame">Der Spielstand konnte nicht gespeichert werden! Bitte stelle sicher, dass du Schreibzugriff auf die Datei hast.</system:String>
    <system:String x:Key="UnableToSaveSavegameProcess">Speichern nicht möglich! Die Datei wird derzeit von einem anderen Prozess verwendet.</system:String>

    <system:String x:Key="SavegameWasModified">Der Spielstand wurde geändert, aber noch nicht gespeichert. Wirklich schließen, ohne zu speichern?</system:String>

    <system:String x:Key="UnableToSelectGameFolder">Der Spieleordner konnte nicht ausgewählt werden!</system:String>
    <system:String x:Key="UnableToLoadSavegameLoadError">Der Dateidialog zum Öffnen des Spielstands konnte nicht gestartet werden!</system:String>
    <system:String x:Key="UnableToLoadSavegameWrongPath">Die ausgewählte Spielstand-Datei existiert nicht!</system:String>

    <system:String x:Key="UnableToSearch">Die Suche konnte nicht durchgeführt werden!</system:String>

    <system:String x:Key="UnableToBackup">Backup konnte nicht erstellt werden! Der Speichervorgang wurde abgebrochen. Bitte überprüfe deine Zugriffsrechte.</system:String>

    <system:String x:Key="UnableToLoadScripts">Die Skriptliste konnte nicht geladen werden! Ein unbekannter Fehler ist aufgetreten.</system:String>

    <system:String x:Key="UnableToLoadVariable">Die Variablenliste konnte nicht importiert werden! Eine oder mehrere Variablen wurden nicht gefunden.</system:String>
    <system:String x:Key="NotFoundVariables">Folgende Variablen wurden nicht gefunden:</system:String>
    <system:String x:Key="UnableToImportVariables">Die Variablenliste konnte nicht importiert werden!</system:String>

    <system:String x:Key="UnableToExportVariables">Die Variablen konnten nicht exportiert werden!</system:String>

    <system:String x:Key="VariablesWereImported">Variablen wurden erfolgreich importiert! Klicke auf „Speichern“, um die Änderungen zu übernehmen.</system:String>
    <system:String x:Key="VariablesWereNotImported">Es wurden keine Variablen geändert. Alle Werte sind bereits identisch.</system:String>
    <system:String x:Key="ScriptActionList">Änderungsliste:</system:String>

    <!-- Statuszeile -->
    <system:String x:Key="LoadingSaveGame">Spielstand wird geladen...</system:String>
    <system:String x:Key="SavingSaveGame">Spielstand wird gespeichert...</system:String>
    <system:String x:Key="ImportingVariables">Variablen werden importiert...</system:String>
    <system:String x:Key="ExportingVariables">Variablen werden exportiert...</system:String>
    <system:String x:Key="BackupCreated">Backup wurde erfolgreich erstellt!</system:String>
    <system:String x:Key="SavedSucessfully">Spielstand wurde erfolgreich gespeichert!</system:String>
    <system:String x:Key="UnableToLoadSavegame">Spielstand konnte nicht geladen werden!</system:String>
    <system:String x:Key="NoNeedToSave">Speichern nicht nötig. Die Datei wurde nicht verändert.</system:String>
    <system:String x:Key="VariablesExportedSucessfully">Variablen wurden erfolgreich exportiert!</system:String>

</ResourceDictionary>

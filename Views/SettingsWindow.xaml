<Window ResizeMode="NoResize" x:Class="GothicSaveEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Tag="{DynamicResource Settings}"
        Style="{DynamicResource WindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Title="{DynamicResource SettingsWindow}" Height="540" Width="640" MinHeight="540" MinWidth="640">

    <Window.InputBindings>
        <KeyBinding Command="{Binding CloseWindowCommand}" Key="Esc"/>
    </Window.InputBindings>

    <StackPanel Margin="16,12,16,16" Orientation="Vertical">
        <!-- Game Folder Card -->
        <Border CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock FontWeight="SemiBold" FontSize="13.5" Text="{DynamicResource SettingsSectionGame}" Margin="0,0,0,8"/>
                <TextBlock FontSize="12.5" Opacity="0.75" Text="{DynamicResource GothicPath}" Margin="0,0,0,6"/>
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Padding="10,0"
                            Grid.Column="0">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding PathLine, Mode=OneWay}"/>
                    </Border>
                    <Button Margin="8,0,0,0"
                            Grid.Column="1"
                            Height="34"
                            Padding="14,0"
                            Content="..."
                            Command="{Binding SelectFolderCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Language & Encoding Card -->
        <Border CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock FontWeight="SemiBold" FontSize="13.5" Text="{DynamicResource SettingsSectionLocalization}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Text="{DynamicResource Language}" FontSize="12.5" Opacity="0.75" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                                  FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <TextBlock Text="{DynamicResource Encoding}" FontSize="12.5" Opacity="0.75" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Encodings}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}"
                                  FontSize="13"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Appearance & System Card -->
        <Border CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock FontWeight="SemiBold" FontSize="13.5" Text="{DynamicResource SettingsSectionAppearance}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              FontSize="13"
                              IsChecked="{Binding DarkMode, Mode=TwoWay}"
                              Content="{DynamicResource DarkMode}"/>
                    <CheckBox Grid.Column="1"
                              FontSize="13"
                              IsChecked="{Binding AssociateSavFiles, Mode=TwoWay}"
                              Content="{DynamicResource AssociateSavFiles}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Backups Card -->
        <Border CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="14,12">
            <StackPanel Orientation="Vertical">
                <TextBlock FontWeight="SemiBold" FontSize="13.5" Text="{DynamicResource SettingsSectionBackups}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              FontSize="13"
                              IsChecked="{Binding KeepBackups, Mode=TwoWay}"
                              Content="{DynamicResource KeepBackups}"/>
                    <Button Grid.Column="1"
                            Height="34"
                            Padding="14,0"
                            Content="{DynamicResource OpenBackupsFolder}"
                            Command="{Binding OpenBackupsFolderCommand}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Height="34"
                            HorizontalAlignment="Left"
                            Padding="14,0"
                            Content="{DynamicResource DeleteBackups}"
                            Command="{Binding DeleteBackupsCommand}"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.8"
                               Text="{Binding BackupsInfo, Mode=OneWay}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

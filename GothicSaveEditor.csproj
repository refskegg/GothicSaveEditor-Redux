<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWPF>true</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <RootNamespace>GothicSaveEditor</RootNamespace>
    <AssemblyName>GothicSaveEditor</AssemblyName>
    <ApplicationIcon>Images\gse_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>GothicSaveEditor.App</StartupObject>
    <AssemblyTitle>GothicSaveEditor Redux</AssemblyTitle>
    <Product>GothicSaveEditor Redux</Product>
    <Authors>GothicSaveEditor Redux</Authors>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Modernized Gothic 1/2 &amp; Mod Savegame Editor (.NET 10)</Description>
    <Copyright>Copyright © 2026 GothicSaveEditor Redux (based on GothicSaveEditor by Flycrafting)</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);GothicSaveEditor.Tests\**;GothicSaveEditor.Core\**;TestData\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="NLog" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\gse_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="GothicSaveEditor.Core\GothicSaveEditor.Core.csproj" />
  </ItemGroup>

</Project>
